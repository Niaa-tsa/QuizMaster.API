@{
    ViewData["Title"] = "QuizMaster";
}

<div class="text-center mt-5">
    <h1 class="display-3 fw-bold">QuizMaster</h1>

    <h3 class="mt-3">Test Your Knowledge</h3>

    <p class="lead mt-3">
        Welcome to QuizMaster!
        Create quizzes, answer questions and test your knowledge.
    </p>

    <div class="mt-4">
        <a asp-controller="Student"
           asp-action="Index"
           class="btn btn-primary btn-lg me-2">
            Student
        </a>

        <a asp-controller="Lecturer"
           asp-action="Index"
           class="btn btn-outline-dark btn-lg">
            Lecturer
        </a>
    </div>
</div>