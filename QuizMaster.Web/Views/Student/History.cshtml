@{
    ViewData["Title"] = "My Results";
}

<div class="container mt-5">
    <h1 class="fw-bold">My Results</h1>

    <p class="text-muted">
        View your previous quiz attempts and scores.
    </p>

    <div class="card shadow-sm mt-4">
        <div class="card-body">
            <h5>No results yet</h5>
            <p class="text-muted">
                Your completed quizzes and scores will appear here.
            </p>
        </div>
    </div>

    <a asp-controller="Student"
       asp-action="Index"
       class="btn btn-outline-primary mt-3">
        Back to Dashboard
    </a>
</div>