@{
    ViewData["Title"] = "Student Dashboard";
}

<div class="container mt-5">
    <h1 class="fw-bold">Student Dashboard</h1>
    <p class="text-muted">
        Welcome to QuizMaster! Test your knowledge.
    </p>

    <div class="card shadow-sm mt-4">
        <div class="card-body">
            <h4>Available Quizzes</h4>
            <p>View available quizzes and start your test.</p>
            <a asp-controller="Student"
               asp-action="Quizzes"
               class="btn btn-primary">
                View Quizzes
            </a>
        </div>
    </div>

    <div class="card shadow-sm mt-3">
        <div class="card-body">
            <h4>My Results</h4>
            <p>Check your previous quiz attempts and scores.</p>
            <a asp-controller="Student"
               asp-action="History"
               class="btn btn-outline-primary">
                View History
            </a>
        </div>
    </div>
</div>