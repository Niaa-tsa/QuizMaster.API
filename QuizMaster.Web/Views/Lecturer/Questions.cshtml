@model List<QuizMaster.Domain.Entities.Question>

@{
    ViewData["Title"] = "Quiz Questions";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="fw-bold">@ViewBag.QuizTitle</h1>
            <p class="text-muted">Manage quiz questions.</p>
        </div>

        <a asp-controller="Lecturer"
           asp-action="AddQuestion"
           asp-route-quizId="@ViewBag.QuizId"
           class="btn btn-primary">
            + Add Question
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mt-3">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mt-3">
            @TempData["Error"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="card shadow-sm mt-4">
            <div class="card-body text-center">
                <h5>No questions added yet</h5>
                <p class="text-muted">
                    Start by adding your first question.
                </p>
            </div>
        </div>
    }
    else
    {
        @for (int i = 0; i < Model.Count; i++)
        {
            var question = Model[i];

            <div class="card shadow-sm mt-4">
                <div class="card-body">

                    <h5>
                        @(i + 1). @question.Text
                    </h5>

                    <p class="text-muted">
                        Type: @question.Type |
                        Points: @question.Points
                    </p>

                    <hr />

                    @foreach (var option in question.AnswerOptions)
                    {
                        <div class="d-flex align-items-center mb-2">
                            <span>@option.Text</span>

                            @if (option.IsCorrect)
                            {
                                <span class="badge bg-success ms-2">
                                    Correct
                                </span>
                            }
                        </div>
                    }

                    <div class="mt-3 d-flex gap-2">

                        <a asp-controller="Lecturer"
                           asp-action="EditQuestion"
                           asp-route-id="@question.Id"
                           class="btn btn-outline-primary">
                            Edit Question
                        </a>

                        <form asp-controller="Lecturer"
                              asp-action="DeleteQuestion"
                              method="post"
                              onsubmit="return confirm('Are you sure you want to delete this question?');">

                            <input type="hidden"
                                   name="id"
                                   value="@question.Id" />

                            <input type="hidden"
                                   name="quizId"
                                   value="@ViewBag.QuizId" />

                            <button type="submit"
                                    class="btn btn-danger">
                                Delete Question
                            </button>

                        </form>

                    </div>

                </div>
            </div>
        }
    }

    <a asp-controller="Lecturer"
       asp-action="MyQuizzes"
       class="btn btn-outline-secondary mt-4">
        Back to My Quizzes
    </a>

</div>