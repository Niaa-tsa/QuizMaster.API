@{
    ViewData["Title"] = "Lecturer Dashboard";
}

<div class="container mt-5">

    <h1 class="fw-bold">Lecturer Dashboard</h1>

    <p class="text-muted">
        Welcome to your QuizMaster workspace.
    </p>

    <div class="row mt-4">

        <div class="col-md-6 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h4>My Quizzes</h4>

                    <p class="text-muted">
                        View and manage your quizzes.
                    </p>

                    <a asp-controller="Lecturer"
                       asp-action="MyQuizzes"
                       class="btn btn-primary">
                        View My Quizzes
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h4>Create New Quiz</h4>

                    <p class="text-muted">
                        Create a new quiz for students.
                    </p>

                    <a asp-controller="Lecturer"
                       asp-action="Create"
                       class="btn btn-success">
                        Create Quiz
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>