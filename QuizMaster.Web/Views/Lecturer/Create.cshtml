@model QuizMaster.Web.Models.CreateQuizViewModel

@{
    ViewData["Title"] = "Create Quiz";
}

<div class="container mt-5">
    <h1 class="fw-bold">Create New Quiz</h1>

    <p class="text-muted">
        Enter your quiz details.
    </p>

    <div class="card shadow-sm mt-4">
        <div class="card-body">

            <form asp-controller="Lecturer"
                  asp-action="Create"
                  method="post">

                <div class="mb-3">
                    <label asp-for="Title" class="form-label">
                        Quiz Title
                    </label>

                    <input asp-for="Title"
                           class="form-control"
                           placeholder="Enter quiz title" />

                    <span asp-validation-for="Title"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TimeLimitMinutes"
                           class="form-label">
                        Time Limit (minutes)
                    </label>

                    <input asp-for="TimeLimitMinutes"
                           type="number"
                           class="form-control"
                           min="1"
                           max="300"
                           placeholder="Enter time limit" />

                    <span asp-validation-for="TimeLimitMinutes"
                          class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">
                    Create Quiz
                </button>

                <a asp-controller="Lecturer"
                   asp-action="Index"
                   class="btn btn-outline-secondary ms-2">
                    Cancel
                </a>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}