@model List<QuizMaster.Domain.Entities.Quiz>

@{
    ViewData["Title"] = "My Quizzes";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="fw-bold">My Quizzes</h1>
            <p class="text-muted">Manage your quizzes.</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Create Quiz
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="card shadow-sm mt-4">
            <div class="card-body text-center">
                <h5>No quizzes created yet</h5>
                <p class="text-muted">Create your first quiz.</p>
            </div>
        </div>
    }
    else
    {
        <div class="row mt-4">

            @foreach (var quiz in Model)
            {
                <div class="col-md-6 mb-3">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">

                            <h5 class="fw-bold">@quiz.Title</h5>

                            <p class="text-muted">
                                Time Limit: @quiz.TimeLimitMinutes minutes
                            </p>

                            <p>
                                @if (quiz.IsPublished)
                                {
                                    <span class="badge bg-success">Published</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Draft</span>
                                }
                            </p>

                            <a asp-controller="Lecturer"
                               asp-action="Questions"
                               asp-route-quizId="@quiz.Id"
                               class="btn btn-primary">
                                View Questions
                            </a>

                            <a asp-controller="Lecturer"
                               asp-action="AddQuestion"
                               asp-route-quizId="@quiz.Id"
                               class="btn btn-outline-primary ms-2">
                                Add Question
                            </a>

                        </div>
                    </div>
                </div>
            }

        </div>
    }

    <a asp-action="Index"
       class="btn btn-outline-secondary mt-3">
        Back to Dashboard
    </a>

</div>